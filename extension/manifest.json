{
  "manifest_version": 3,
  "name": "Fırsat Radarı",
  "short_name": "Fırsat Radarı",
  "version": "1.0.0",
  "description": "Technopat, Donanım Arşivi, R10 ve DonanımHaber'deki indirim konularını tek listede toplar; takip ettiğin ürünler için bildirim gönderir.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fırsat Radarı",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.technopat.net/*",
    "https://technopat.net/*",
    "https://forum.donanimarsivi.com/*",
    "https://www.r10.net/*",
    "https://r10.net/*",
    "https://forum.donanimhaber.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}
